{
  "name": "zimage-triposr-et3",
  "title": "berkelium-zimage",
  "slug": "berkelium-zimage",
  "description": "M5 (Z-Image-Turbo bring-up with precision study) then every E-T3 unit for zimage-triposr: verified fetch, text encoder -> freed, two transformer shards (one per T4) -> anchors, TripoSR in its own overlay venv -> meshes",
  "accelerator": "t4x2",
  "include": [
    "services/neural",
    "scripts",
    "benchmarks",
    "configs"
  ],
  "include_files": [
    "results/text3d/E-T3/units.jsonl"
  ],
  "steps": [
    {
      "name": "deps_stage_a",
      "cmd": "pip install -q -r configs/environments/zimage-cuda.txt",
      "env": {
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
      }
    },
    {
      "name": "venv_stage_b",
      "cmd": "python -m venv --system-site-packages --without-pip .venv-triposr-cuda && .venv-triposr-cuda/bin/python -m pip install -q -r configs/environments/triposr-cuda.txt && .venv-triposr-cuda/bin/python -c \"import transformers, huggingface_hub; assert transformers.__version__ == '4.57.6', transformers.__version__; print(transformers.__version__, huggingface_hub.__version__)\"",
      "env": {
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
      }
    },
    {
      "name": "fetch",
      "cmd": "python scripts/zimage_triposr_batch.py fetch",
      "env": {
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
      }
    },
    {
      "name": "m5_smoke",
      "cmd": "python scripts/m5_image_prior_smoke.py --i-approve-gpu-cost",
      "env": {
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
      }
    },
    {
      "name": "embed",
      "cmd": "python scripts/zimage_triposr_batch.py embed --te-dtype from-m5",
      "env": {
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
      }
    },
    {
      "name": "anchors",
      "parallel": [
        "CUDA_VISIBLE_DEVICES=0 python scripts/zimage_triposr_batch.py anchors --dtype from-m5 --shard 0/2",
        "CUDA_VISIBLE_DEVICES=1 python scripts/zimage_triposr_batch.py anchors --dtype from-m5 --shard 1/2"
      ],
      "env": {
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
      }
    },
    {
      "name": "reconstruct",
      "parallel": [
        "CUDA_VISIBLE_DEVICES=0 .venv-triposr-cuda/bin/python scripts/zimage_triposr_batch.py reconstruct --shard 0/2",
        "CUDA_VISIBLE_DEVICES=1 .venv-triposr-cuda/bin/python scripts/zimage_triposr_batch.py reconstruct --shard 1/2"
      ],
      "env": {
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
      }
    }
  ],
  "outputs": [
    "results/m5/**",
    "results/text3d/E-T3/units_zimage-triposr_*.jsonl",
    "results/text3d/E-T3/units/zimage-triposr/**",
    "data/models/zimage_turbo/*/verified.json",
    "data/models/triposr/*/verified.json"
  ],
  "env_note": "PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True on every GPU step (fragmentation next to a 12.3 GB resident transformer)"
}
