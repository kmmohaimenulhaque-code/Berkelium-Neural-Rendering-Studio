{
  "name": "berkelium-studio",
  "productName": "Berkelium",
  "private": true,
  "version": "0.1.0",
  "description": "Berkelium Neural Rendering Studio",
  "author": "Team Berkelium",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\"",
    "electron": "electron electron/main.cjs",
    "preview:app": "vite build && electron electron/main.cjs --dist",
    "smoke": "electron electron/smoke.cjs",
    "package": "vite build && electron-builder --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "studio": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && npm run electron\""
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.55.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^2.1.9",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "@electron/get": {
      "global-agent": "^4.1.3"
    }
  },
  "build": {
    "appId": "ai.berkelium.studio",
    "productName": "Berkelium",
    "artifactName": "Berkelium-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Berkelium ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Berkelium"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "synopsis": "Neural rendering studio"
    },
    "publish": null
  }
}
